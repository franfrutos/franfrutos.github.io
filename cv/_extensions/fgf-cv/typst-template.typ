// =============================================================================
// fgf-cv — a Quarto Typst format that carries the franfrutos.github.io
// design language (IBM Plex Mono, coral accent, dot-divider motif, hairline
// section rules, Academicons + Font Awesome icons) onto a light, printable page.
//
// Palette mirrors the site's *light* design tokens (theme.scss):
//   ink #1a1d24 · ink2 #454b59 · ink3 #878d9b · line #e1e3e9 · accent #e8421d
// The body of the document is generated by scripts/build-cv.mjs, which calls
// the helper functions defined below.
// =============================================================================

// Light by default; a dark variant is produced by recompiling with
// `--input fgfdark=1` (see _quarto.yml post-render). Palettes mirror the
// website's light and `html.fgf-dark` design tokens (theme.scss).
#let _dark  = sys.inputs.at("fgfdark", default: "0") == "1"
// Compact mode (Short CV profile): `--input fgfcompact=1` at typst-compile
// time. The default branch holds the full-CV spacing; the compact branch is
// the denser Short-CV spacing. Components are IDENTICAL in both modes — only
// the SP tokens below differ.
#let _compact = sys.inputs.at("fgfcompact", default: "0") == "1"
#let SP = if _compact {(
  margin: (top: 1.7cm, bottom: 1.5cm, left: 1.7cm, right: 1.7cm),
  body-size: 9pt,
  sec-above: 17pt, sec-below: 7.5pt,
  entry-above: 9.5pt,
  stay-above: 7pt,
  kv-above: 5pt,
  method-above: 5pt, method-col: 3.9cm,
  pub-above: 6.5pt,
  subhead-above: 9.5pt, subhead-below: 3pt,
)} else {(
  margin: (top: 1.8cm, bottom: 1.55cm, left: 1.8cm, right: 1.8cm),
  body-size: 9pt,
  sec-above: 18pt, sec-below: 8pt,
  entry-above: 11pt,
  stay-above: 8pt,
  kv-above: 6pt,
  method-above: 6pt, method-col: 4.3cm,
  pub-above: 7.5pt,
  subhead-above: 11pt, subhead-below: 3pt,
)}
#let ink    = if _dark { rgb("#e9ebef") } else { rgb("#1a1d24") }  // primary text
#let ink2   = if _dark { rgb("#aab0bd") } else { rgb("#454b59") }  // secondary
#let ink3   = if _dark { rgb("#6c7382") } else { rgb("#878d9b") }  // muted meta
#let hair   = if _dark { rgb("#2b2f3a") } else { rgb("#e1e3e9") }  // hairlines
#let accent = if _dark { rgb("#ff5a3c") } else { rgb("#e8421d") }  // coral
#let paper  = if _dark { rgb("#1b1e26") } else { white }           // page fill
#let chip   = if _dark { rgb("#2a2018") } else { accent.lighten(91%) }  // badge fill
#let chipln = if _dark { rgb("#5a3a30") } else { accent.lighten(55%) }  // badge stroke
#let mono   = "IBM Plex Mono"      // label layer: masthead, section labels, org lines, dates, field labels, footer
#let serif  = "Source Serif 4"     // reading layer: entry titles, references, bodies, field values

// --- Icon fonts (bundled in fonts/). Glyph codepoints taken from the same
//     Font Awesome 6.6 / Academicons 1.9.4 the website loads. -----------------
#let FA_SOLID  = "Font Awesome 6 Free Solid"
#let FA_BRANDS = "Font Awesome 6 Brands"
#let AI        = "Academicons"
#let _ICONS = (
  phone:   (FA_SOLID,  "\u{f095}"),
  email:   (FA_SOLID,  "\u{f0e0}"),
  web:     (FA_SOLID,  "\u{f0ac}"),
  github:  (FA_BRANDS, "\u{f09b}"),
  bluesky: (FA_BRANDS, "\u{e671}"),
  scholar: (AI,        "\u{e9d4}"),
  orcid:   (AI,        "\u{e9d9}"),
  osf:     (AI,        "\u{e9ef}"),
  zenodo:  (AI,        "\u{e911}", 1.75),  // boxed wordmark: short glyph, scaled to match the marks
)
#let icon(name, size: 9.5pt, fill: accent) = {
  let s = _ICONS.at(name, default: none)
  if s != none {
    // Optional per-glyph scale (see zenodo). Academicons glyphs are centred 0.375em
    // above the baseline, so scaling raises the centre by 0.375em * (k - 1): lower it
    // by exactly that. Collapsed edges stop the bigger glyph from growing the line.
    let k = s.at(2, default: 1)
    let edges = if k == 1 { (:) } else { (top-edge: "baseline", bottom-edge: "baseline") }
    text(font: s.at(0), size: size * k, fill: fill, baseline: 0.6pt + size * 0.375 * (k - 1), ..edges)[#s.at(1)]
  }
}
// Open-science practice glyphs as (font, codepoint). Most are Academicons;
// "open code" uses Font Awesome's </> (fa-code), matching the website.
#let _OSF = (
  prereg:    (AI,       "\u{e906}"),  // ai-preregistered
  materials: (AI,       "\u{e968}"),  // ai-open-materials
  data:      (AI,       "\u{e966}"),  // ai-open-data
  code:      (FA_SOLID, "\u{f121}"),  // fa-code </>
  oa:        (AI,       "\u{e939}"),  // ai-open-access
  preprint:  (AI,       "\u{e90e}"),  // ai-psyarxiv — a preprint shows its PsyArXiv glyph in the OA slot
  biorxiv:   (AI,       "\u{e9a2}"),  // ai-biorxiv  — same slot, for a bioRxiv preprint
  postprint: (AI,       "\u{e90e}"),  // ai-psyarxiv — shown in the OA slot when not OA but a postprint is shared
  cran:      (FA_BRANDS, "\u{f4f7}"),  // fa-r-project — the paper introduces an R package on CRAN
  production:(FA_SOLID, "\u{f013}"),  // fa-gear — accepted/in press, final access status still pending
)

// --- Section header: coral tick + uppercase muted label + hairline rule.
//     `sticky` keeps the header on the same page as the entry that follows it. -
#let cvsection(title) = block(above: SP.sec-above, below: SP.sec-below, breakable: false, sticky: true, width: 100%, {
  grid(
    columns: (auto, 1fr),
    column-gutter: 12pt,
    align: horizon,
    {
      box(width: 22pt, height: 2pt, fill: accent, baseline: -2.5pt)
      h(9pt)
      text(font: mono, size: 8.6pt, weight: "semibold", tracking: 1.4pt, fill: ink3)[#upper(title)]
    },
    line(length: 100%, stroke: 0.6pt + hair),
  )
})

// --- A two-column entry: title / right-meta, org / dates, then body. --------
#let entry(title: none, right: none, org: none, dates: none, body: none) = {
  block(above: SP.entry-above, below: 0pt, breakable: false, width: 100%, {
    if title != none or right != none {
      grid(
        columns: (1fr, auto),
        column-gutter: 16pt,
        align: (start + bottom, end + bottom),
        text(font: serif, size: 10pt, weight: "semibold", fill: ink)[#title],
        text(font: mono, size: 8.4pt, style: "italic", fill: ink3)[#right],
      )
    }
    if org != none or dates != none {
      v(3pt)
      grid(
        columns: (1fr, auto),
        column-gutter: 16pt,
        // top-aligned so a two-line org keeps the date pinned to its first line
        align: (start + top, end + top),
        text(font: mono, size: 7.6pt, weight: "medium", tracking: 0.7pt, fill: ink3)[#upper(org)],
        text(font: mono, size: 8.4pt, style: "italic", fill: ink3)[#dates],
      )
    }
    if body != none {
      v(if _compact { 3pt } else { 5pt })
      set text(font: serif, size: SP.body-size, fill: ink2)
      set par(leading: 7.4pt, justify: false)
      body
    }
  })
}

// --- A nested RESEARCH STAY under a main position: indented, with a coral
//     small-caps label so international stays read as first-class merits. ------
#let substay(title: none, place: none, dates: none, body: none) = {
  // A hairline on the left visually ties the stay to its parent position.
  // Two tight rows (title | place, body | dates) — the same compact structure
  // in BOTH profiles; only the surrounding spacing differs (via SP / _compact).
  block(above: SP.stay-above, below: 0pt, breakable: false, width: 100%,
    stroke: (left: 1pt + hair),
    inset: if _compact { (left: 10pt, top: 1pt, bottom: 1pt) } else { (left: 12pt, top: 2pt, bottom: 2pt) }, {
    text(font: mono, size: 7.2pt, weight: "semibold", tracking: 1.3pt, fill: accent)[RESEARCH STAY]
    v(if _compact { 2.5pt } else { 3.5pt })
    grid(
      columns: (1fr, auto),
      column-gutter: 16pt,
      align: (start + top, end + top),
      text(font: serif, size: 9.4pt, weight: "semibold", fill: ink)[#title],
      text(font: mono, size: 8.4pt, style: "italic", fill: ink3)[#place],
    )
    if body != none or dates != none {
      v(if _compact { 1.5pt } else { 2.5pt })
      grid(
        columns: (1fr, auto),
        column-gutter: 16pt,
        align: (start + top, end + top),
        {
          set text(font: serif, size: SP.body-size, fill: ink2)
          set par(leading: 7.4pt, justify: false)
          if body != none { body }
        },
        text(font: mono, size: 8.4pt, style: "italic", fill: ink3)[#dates],
      )
    }
  })
}

// --- Labeled inline field used inside entry bodies (Thesis:, Supervisor:…). -
#let kv(label, value) = block(above: SP.kv-above, below: 0pt, {
  text(font: mono, size: 7.6pt, weight: "semibold", fill: ink)[#label:]
  h(5pt)
  text(font: serif, size: SP.body-size, fill: ink2)[#value]
})

// --- A small rounded "open science" badge (Academicons glyph), as a soft
//     coral chip so the open-science practices read at a glance. -------------
#let osfbadge(key, on: true, url: none) = {
  let g = _OSF.at(key)
  let chipbox = box(
    inset: (x: 3.5pt, y: 2.5pt),
    radius: 3pt,
    fill: if on { chip } else { none },
    stroke: 0.5pt + if on { chipln } else { hair },
    baseline: 3.6pt,
    text(font: g.at(0), size: 8.5pt, fill: if on { accent } else { ink3 })[#g.at(1)],
  )
  // Lit badges link to their resource (same semantics as the website badges).
  if on and url != none { link(url, chipbox) } else { chipbox }
}

// --- A right-aligned label + value row (Methods & Technical Expertise). -----
#let methodrow(label, value) = block(above: SP.method-above, below: 0pt, {
  grid(
    columns: (SP.method-col, 1fr),
    column-gutter: 14pt,
    align: (end + top, start + top),
    text(font: mono, size: 8pt, weight: "semibold", fill: ink)[#label],
    {
      set par(leading: 7.4pt, justify: false)
      text(font: serif, size: SP.body-size, fill: ink2)[#value]
    },
  )
})

// --- A publication / talk list item: coral bullet + body + optional badges. --
#let pubitem(body, badges: ()) = block(above: SP.pub-above, below: 0pt, breakable: false, width: 100%, {
  grid(
    columns: (14pt, 1fr),
    column-gutter: 4pt,
    align: (left + top, left + top),
    { v(5pt); box(width: 7pt, height: 1.8pt, fill: accent, radius: 0.9pt) },
    {
      set text(font: serif, size: SP.body-size, fill: ink2)
      set par(leading: 7.4pt, justify: false)
      body
      if badges.len() > 0 {
        v(3pt)
        box(stack(dir: ltr, spacing: 5pt, ..badges.map(b => osfbadge(b.at(0), on: b.at(1), url: b.at(2, default: none)))))
      }
    },
  )
})

// --- A small uppercase subgroup label (e.g. ORAL PRESENTATIONS). ------------
#let subhead(title) = block(above: SP.subhead-above, below: SP.subhead-below, sticky: true, {
  text(font: mono, size: 7.8pt, weight: "semibold", tracking: 1.1pt, fill: accent)[#upper(title)]
})

// --- A visibly-clickable link for titles (publications, theses): signalled by
//     COLOR, not italics (italics stay purely semantic, e.g. APA titles).
//     Restrained member of the accent family: darkened coral on light paper
//     (adequate contrast on white, reads as mid-gray in grayscale prints),
//     the existing lighter coral on dark paper. Masthead contacts keep plain
//     links — the coral icons already signal those. -----------------------------
#let linkc = if _dark { accent } else { accent.darken(22%) }
#let plink(url, body) = link(url, text(fill: linkc, body))

// --- Masthead. --------------------------------------------------------------
// contacts: array of (icon: str, label: str, url: str or none)
#let cvheader(
  name: "",
  surname: "",
  role: "",
  field: "",
  location: "",
  tagline: "",
  contacts: (),
) = {
  set align(center)
  // Name: match the website masthead — both words semibold, surname in coral.
  // The masthead is deliberately IDENTICAL in both profiles (no _compact
  // branches): Full and Short must read as the same CV.
  block(below: 0pt, {
    text(font: mono, size: 22pt, weight: "semibold", tracking: 0.2pt, fill: ink)[#name ]
    text(font: mono, size: 22pt, weight: "semibold", tracking: 0.2pt, fill: accent)[#surname]
  })
  v(5pt)
  text(font: mono, size: 8pt, weight: "medium", tracking: 2.2pt, fill: ink2)[
    #upper(role)#h(8pt)#text(fill: accent)[·]#h(8pt)#upper(field)
  ]
  v(2pt)
  text(font: mono, size: 8.6pt, style: "italic", fill: ink3)[#location]
  v(8pt)
  // Sized + spaced so all contacts fit on ONE line (no orphaned "Bluesky").
  block(width: 100%, {
    set text(font: mono, size: 8pt, fill: ink2)
    contacts
      .map(c => box({
        icon(c.icon, size: 9pt, fill: accent)
        h(4pt)
        if c.url != none { link(c.url)[#text(fill: ink2)[#c.label]] } else { text(fill: ink2)[#c.label] }
      }))
      .join(box(inset: (x: 5.5pt), text(fill: ink3.lighten(15%))[\u{2022}]))
  })
  if tagline != "" {
    v(13pt)
    block(width: 80%, {
      set text(font: serif, size: 10pt, style: "italic", fill: ink2)
      set par(leading: 6.6pt, justify: false)
      tagline
    })
  }
  // Clean coral rule closes the masthead (replaces the dot motif).
  v(11pt)
  box(width: 42pt, height: 2.5pt, fill: accent, radius: 1.25pt)
  set align(left)
  v(2pt)
}

// --- The document wrapper, applied as a show rule by typst-show.typ. ---------
#let cv(doc) = {
  set document(
    title: "Francisco Garre-Frutos — Curriculum Vitae",
    author: "Francisco Garre-Frutos",
  )
  set page(
    paper: "a4",
    fill: paper,
    margin: SP.margin,
    footer: context {
      set text(font: mono, size: 7.6pt, tracking: 0.5pt, fill: ink3)
      grid(
        columns: (1fr, auto, 1fr),
        align: (left + horizon, center + horizon, right + horizon),
        upper(datetime.today().display("[month repr:long] [year]")),
        upper[Francisco Garre-Frutos #h(4pt)·#h(4pt) Curriculum Vitae],
        [#counter(page).display()],
      )
    },
  )
  set text(font: serif, size: SP.body-size, weight: "regular", fill: ink, lang: "en", hyphenate: false)
  set par(leading: 7.4pt, spacing: 7.4pt, justify: false)
  doc
}
